# text = སྦྱར་རོ།།མ་ག་དྷའི་མ་སྐྱེས་དགས་ཀྱང་དེ་རྣམས་སྐུ་གདུང་གི་སྐལ་བ་ལེན་དུ་སོང་ཞེས་ཐོས་ནས།ཆས་ཏེ།གླང་པོ་ཆེ་ལ་ཞོན་པ་དང་།སྟོན་པའི་ཡོན་ཏན་དྲན་ཏེ་བརྒྱལ་ལོ།།དེ་ནས་དབྱར་བྱེད་བཏང་སྟེ།ངའི་བཀས་གྱད་རྣམས་ལ་གནོད་པ་ཆུང་ངམ།ཉམ་ང་བ་ཆུང་ངམ།བསྐྱོད་པ་ཡང་ངམ།འཚོའམ།སྟོབས་དང་ལྡན་ནམ།བདེ་བ་ལ་རེག་པར་གནས་སམ།ཞེས་དྲིས་ལ།སྟོན་པ་ནི་ངེད་ལ་ཡུན་རིང་པོ་ནས་ཕངས་ཤིང་།བླ་མར་གྱུར་པ་ཡིན་ཏེ།དེ་ཁྱོད་ཀྱི་གྲོང་གི་ཉེ་འཁོར་དུ་འདས་པས།གདུང་གི་སྐལ་པ་ངེད་ལ་བྱིན་ཅིག།རྒྱལ་པོའི་ཁབ་ཏུ་མཆོད་རྟེན་བརྩིགས་ནས་མཆོད་པ་དང་།དུས་སྟོན་བྱའོ་ཞེས་སྨྲས་ཤིག།དེ་ནས་དབྱར་བྱེད་ཀྱིས།དེ་བཞིན་བྱས་པ་དང་།གྱད་རྣམས་ན་རེ།ངེད་ཀྱང་དེ་བཞིན་བྱེད་ཟེར་རོ།།འོ་ན་དམག་གིས་དབྲོག་གོ་ཞེས་བྱས་པས།དེ་བཞིན་བྱའོ་ཟེར་ཏེ།གྱད་ཀྱི་ཆུང་མ་དང་གཞོན་ནུ་རྣམས་ཀྱིས་ཀྱང་འཕོངས་བསླབས་ཏེ།གཞན་གྱི་དཔུང་ཡན་ལག་བཞི་དང་འཐབ་པའི་ཕྱིར།གྱད་རྣམས་ཡན་ལག་བཞི་གོ་བསྐོན་ཏེ་ཕྱིར་བྱུང་ངོ་།།དེའི་ཚེ།བྲམ་ཟེའི་རིགས་བྲེ་བོ་དང་མཉམ་པས་དེ་དག་འཐབ་ན།གཅིག་འཆི་བར་རིག་ནས།ཙྭ་ཅན་གྱི་གྱད་རྣམས་ལ་སྨྲས་པ།སྟོན་པ་ནི་ཡུན་རིང་པོ་ནས་བཟོད་པ་དང་ལྡན་པ།བཟོད་པའི་བསྔགས་པ་བརྗོད་པ་ཡིན་པ་ལ།སྐུ་གདུང་གི་ཕྱིར།གཅིག་གིས་གཅིག་གསོད་པར་མི་རིགས་ཀྱིས།བདག་གིས་སྐུ་གདུང་ཆ་བརྒྱད་དུ་བགོས་ལ་སྦྱིན་བུམ་པ་ལ་ཁོ་བོས་མཆོད་པ་བྱའོ།།ཞེས་སྨྲས་པས།གྱད་ན་རེ་དེ་བཞིན་བྱའོ་ཟེར་རོ།།དེ་ནས་སྡིག་ཅན་གྱི་གྱད་ནས་དབྱར་བྱེད་ཀྱི་བར་ལ་
