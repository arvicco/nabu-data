          },
          {
            "name": "Words",
            "type": "integer"
          },
          {
            "name": "Docs",
            "type": "integer"
          },
          {
            "name": "Source",
            "type": "string"
          }
        ],
        "primaryKey": [
          "ID"
        ]
      }
    },
    {
      "name": "hiero_glyphs",
      "path": "hiero-glyphs.csv",
      "schema": {
        "fields": [
          {
            "name": "ID",
            "type": "string"
          },
          {
            "name": "Codepoint",
            "type": "string"
