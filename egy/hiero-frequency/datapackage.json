          {
            "name": "Glyph",
            "type": "string"
          },
          {
            "name": "Texts",
            "type": "integer"
          },
          {
            "name": "Signs",
            "type": "integer"
          },
          {
            "name": "Words",
            "type": "integer"
          },
          {
            "name": "Unclear",
            "type": "integer"
          },
          {
            "name": "Source",
            "type": "string"
          }
        ],
        "primaryKey": [
          "ID"
        ]
      }
    },
    {
      "name": "languages",
      "path": "languages.csv",
      "schema": {
        "fields": [
          {
            "name": "ID",
            "type": "string"
          },
          {
            "name": "Name",
            "type": "string"
          },
          {
            "name": "Glottocode",
            "type": "string"
          },
          {
            "name": "ISO639P3code",
            "type": "string"
          }
        ],
        "primaryKey": [
          "ID"
        ]
      }
    },
    {
      "name": "sources",
      "path": "sources.bib",
      "format": "bibtex",
      "mediatype": "text/x-bibtex"
