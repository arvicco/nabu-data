{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "egy-hiero-frequency",
  "title": "Egyptian hieroglyph frequencies — Gardiner codes censused from AES per subcorpus, with word-grain and damaged-attestation counts",
  "version": "1.0.0",
  "licenses": [
    {
      "name": "CC-BY-SA-4.0",
