            "name": "ID",
            "type": "string"
          },
          {
            "name": "Variant",
            "type": "string"
          },
          {
            "name": "Traditional",
            "type": "string"
          },
          {
            "name": "Variant_Codepoint",
            "type": "string"
          },
          {
            "name": "Traditional_Codepoint",
            "type": "string"
          },
          {
            "name": "Source",
            "type": "string"
          }
        ],
        "primaryKey": [
          "ID"
        ]
      }
    },
    {
      "name": "refusals",
      "path": "refusals.csv",
      "schema": {
        "fields": [
          {
            "name": "ID",
            "type": "string"
          },
          {
            "name": "Form",
            "type": "string"
          },
          {
            "name": "Reason",
            "type": "string"
          },
          {
            "name": "Source",
            "type": "string"
          }
        ],
        "primaryKey": [
